# ABHIMANYU DTN — Environment Configuration Template
# Copy to .env for local development or configure in Render / Railway Dashboard.

# Runtime environment: 'production' or 'development'
DTN_ENV=development

# Database file location (Render Free tier: /tmp/demo_system.db; Persistent volume: /data/demo_system.db)
DTN_DB_PATH=data/demo_system.db

# Administrator Secret Token
# In production, this MUST be set to a cryptographically random secret (>= 16 chars).
# On Render Blueprint, this is automatically generated via 'generateValue: true'.
# Example manual generator: python -c "import secrets; print(secrets.token_urlsafe(32))"
DTN_ADMIN_TOKEN=dev-admin-secret-token

# Allowed CORS origins for browser dashboards (comma-separated, no trailing slashes)
# In production, leave empty unless exposing a browser-based web frontend.
DTN_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Port (assigned automatically by cloud platform; default is 8000)
PORT=8000

