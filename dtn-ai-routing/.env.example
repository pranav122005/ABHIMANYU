# ABHIMANYU DTN — Environment Configuration Template
# Copy to .env for local development or configure in Railway Dashboard -> Variables.

# Runtime environment: 'production' or 'development'
DTN_ENV=development

# Database file location (on Railway, mount volume at /data and set to /data/demo_system.db)
DTN_DB_PATH=data/demo_system.db

# Administrator Secret Token
# In production, this MUST be set to a cryptographically random secret (>= 16 chars).
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(32))"
DTN_ADMIN_TOKEN=dev-admin-secret-token

# Allowed CORS origins for browser dashboards (comma-separated, no trailing slashes)
# Example for Streamlit Community Cloud: https://abhimanyu-dtn.streamlit.app
DTN_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Port (assigned automatically by Railway; default is 8000)
PORT=8000

